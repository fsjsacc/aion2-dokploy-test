          "value": "\"content_reports\".\"service\" in ('kr-tw-live', 'global', 'unknown', 'other')"
        },
        "content_reports_category_check": {
          "name": "content_reports_category_check",
          "value": "\"content_reports\".\"category\" in ('outdated', 'incorrect', 'translation', 'missing', 'broken-link', 'other')"
        },
        "content_reports_status_check": {
          "name": "content_reports_status_check",
          "value": "\"content_reports\".\"status\" in ('new', 'triaged', 'accepted', 'rejected', 'resolved')"
        },
        "content_reports_lengths_check": {
          "name": "content_reports_lengths_check",
          "value": "\n        length(\"content_reports\".\"id\") between 1 and 64\n        and length(\"content_reports\".\"target_key\") between 1 and 300\n        and (\"content_reports\".\"version\" is null or length(\"content_reports\".\"version\") between 1 and 80)\n        and length(\"content_reports\".\"message\") between 10 and 2000\n        and (\"content_reports\".\"evidence_url\" is null or length(\"content_reports\".\"evidence_url\") <= 2048)\n        and (\"content_reports\".\"contact\" is null or length(\"content_reports\".\"contact\") <= 254)\n        and length(\"content_reports\".\"requester_hash\") = 64\n      "
        },
        "content_reports_resolution_check": {
          "name": "content_reports_resolution_check",
          "value": "\"content_reports\".\"resolved_at\" is null or \"content_reports\".\"status\" <> 'new'"
        }
