      "checkConstraints": {
        "analytics_daily_day_check": {
          "name": "analytics_daily_day_check",
          "value": "\n        length(\"analytics_daily\".\"day\") = 10\n        and \"analytics_daily\".\"day\" glob '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n      "
        },
        "analytics_daily_event_name_check": {
          "name": "analytics_daily_event_name_check",
          "value": "\n        length(\"analytics_daily\".\"event_name\") between 1 and 64\n        and \"analytics_daily\".\"event_name\" not glob '*[^a-z0-9_]*'\n      "
        },
        "analytics_daily_locale_check": {
          "name": "analytics_daily_locale_check",
          "value": "\"analytics_daily\".\"locale\" in ('zh-hant', 'en', 'ko', 'unknown')"
        },
        "analytics_daily_service_check": {
          "name": "analytics_daily_service_check",
          "value": "\"analytics_daily\".\"service\" in ('kr-tw-live', 'global', 'unknown', 'other')"
        },
        "analytics_daily_surface_check": {
          "name": "analytics_daily_surface_check",
          "value": "\"analytics_daily\".\"surface\" in ('unknown', 'home', 'home-hero', 'home-core-entry', 'home-directory', 'faction-gate', 'content-hub', 'map-seo', 'interactive-map', 'daily-checklist', 'class-finder', 'material-calculator', 'correction-report')"
        },
        "analytics_daily_target_kind_check": {
          "name": "analytics_daily_target_kind_check",
          "value": "\"analytics_daily\".\"target_kind\" in ('none', 'content', 'item', 'map', 'tool')"
        },
        "analytics_daily_target_key_check": {
          "name": "analytics_daily_target_key_check",
          "value": "\n        length(\"analytics_daily\".\"target_key\") between 1 and 160\n        and \"analytics_daily\".\"target_key\" not glob '*[^a-z0-9._:/-]*'\n        and (\n          (\"analytics_daily\".\"target_kind\" = 'none' and \"analytics_daily\".\"target_key\" = 'none')\n          or (\"analytics_daily\".\"target_kind\" <> 'none' and \"analytics_daily\".\"target_key\" <> 'none')\n        )\n      "
        },
        "analytics_daily_counter_check": {
          "name": "analytics_daily_counter_check",
          "value": "\"analytics_daily\".\"count\" >= 1 and \"analytics_daily\".\"updated_at\" >= 1"
        }
      }
