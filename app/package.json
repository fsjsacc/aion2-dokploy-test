{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/production/generate-sites-bootstrap-plan.mjs",
    "build": "vinext build",
    "postbuild": "node scripts/production/prune-retired-map-bootstrap.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/content-routes.test.mjs tests/trending-intent-content.test.mjs tests/report-api.test.mjs tests/event-api.test.mjs tests/journey-event-api.test.mjs tests/tracking-security.test.mjs tests/admin-auth.test.mjs tests/admin-api.test.mjs tests/external-link-api.test.mjs tests/checklist-reset.test.mjs tests/checklist-store.test.mjs tests/event-timer.test.mjs tests/material-calculator.test.mjs tests/material-tool-localization.test.mjs tests/crafting-catalog.test.mjs tests/map-analytics-coverage.test.mjs tests/map-data-pipeline.test.mjs tests/map-tile-sync.test.mjs tests/map-runtime-bundles.test.mjs tests/production-architecture.test.mjs tests/content-release-pipeline.test.mjs tests/content-source-health.test.mjs tests/content-expansion.test.mjs tests/editorial-localization.test.mjs tests/public-ui-localization.test.mjs tests/tool-localization.test.mjs tests/content-facts-localization.test.mjs tests/home-localization.test.mjs tests/database-interface.test.mjs tests/item-detail.test.mjs tests/r2-release-publisher.test.mjs tests/sites-r2-release.test.mjs",
    "test:map-data": "node --test tests/map-data-pipeline.test.mjs",
    "test:map-bundles": "node --test tests/map-runtime-bundles.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "sync:map-seo": "node scripts/sync-map-seo-data.mjs",
    "sync:map-tiles": "node scripts/map-data/sync-map-tiles.mjs",
    "map-data:release": "node scripts/map-data/release.mjs",
    "map-data:check": "node scripts/map-data/check.mjs",
    "production:check": "node scripts/production/check-production.mjs",
    "production:check:activated": "node scripts/production/check-production.mjs --require-activated",
    "release:plan": "node scripts/production/release-plan.mjs",
    "release:database": "node scripts/production/database-release.mjs",
    "release:content": "node scripts/content/release.mjs",
    "content:check-remote": "node scripts/content/check-remote-sources.mjs",
    "crafting:generate": "node scripts/crafting/generate-catalog.mjs",
    "items:sync": "node scripts/items/sync-official-items.mjs --force",
    "release:r2": "node scripts/production/publish-r2-release.mjs",
    "release:r2:sites": "node scripts/production/publish-sites-r2-release.mjs",
    "release:r2:sites:bootstrap": "node scripts/production/bootstrap-sites-r2-release.mjs",
    "release:bootstrap-plan": "node scripts/production/generate-sites-bootstrap-plan.mjs",
    "release:rollback": "node scripts/production/rollback-release.mjs",
    "test:release-r2": "node --test tests/r2-release-publisher.test.mjs",
    "verify:public": "node scripts/production/verify-public-site.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^6.10.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
